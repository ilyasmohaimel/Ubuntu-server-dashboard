FROM alpine:3.22 AS fetch

ARG ARIANG_VERSION=1.3.14
ARG ARIANG_SHA256=65bc5ed3573ef05313ea953a5c5363c8b33a4996849b2986c78660eab1a9edb2
RUN apk add --no-cache curl unzip \
    && curl -fsSL "https://github.com/mayswind/AriaNg/releases/download/${ARIANG_VERSION}/AriaNg-${ARIANG_VERSION}-AllInOne.zip" -o /tmp/ariang.zip \
    && echo "${ARIANG_SHA256}  /tmp/ariang.zip" | sha256sum -c - \
    && mkdir -p /opt/ariang \
    && unzip /tmp/ariang.zip -d /opt/ariang

FROM nginx:1.27-alpine

COPY --from=fetch /opt/ariang/ /usr/share/nginx/html/
COPY nginx-ariang.conf /etc/nginx/conf.d/default.conf
